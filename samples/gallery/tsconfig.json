{
  "extends": "gts/tsconfig-google.json",
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@ghchinoy/lit-audio-ui": ["../../packages/lit-audio-ui/src/index.ts"],
      "@ghchinoy/lit-audio-ui/atoms/*.js": ["../../packages/lit-audio-ui/src/components/atoms/*.ts"],
      "@ghchinoy/lit-audio-ui/molecules/*.js": ["../../packages/lit-audio-ui/src/components/molecules/*.ts"],
      "@ghchinoy/lit-audio-ui/organisms/*.js": ["../../packages/lit-audio-ui/src/components/organisms/*.ts"],
      "@ghchinoy/lit-audio-ui/providers/*.js": ["../../packages/lit-audio-ui/src/components/providers/*.ts"],
      "@ghchinoy/lit-audio-ui/utils/*.js": ["../../packages/lit-audio-ui/src/utils/*.ts"]
    }
  },
  "include": ["**/*.ts", "vite.config.ts", "../../packages/lit-audio-ui/src/**/*.ts"]
}
