{
  "name": "@ghchinoy/lit-prompt-editor",
  "version": "0.1.0",
  "description": "A high-performance Canvas-based text editor for AI prompt experiences, powered by Pretext",
  "author": "G. Hussain Chinoy",
  "license": "Apache-2.0",
  "main": "dist/scream-prompt-editor.umd.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/scream-prompt-editor.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && npm run build:lib",
    "clean": "rimraf dist",
    "build:lib": "tsc && vite build",
    "lint": "gts lint",
    "fix": "gts fix",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "@material/web": "^2.0.0",
    "lit": "^3.3.1"
  },
  "dependencies": {
    "@chenglou/pretext": "file:../../../../dev/github/pretext"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint-plugin-lit": "^1.15.0",
    "gts": "^7.0.0",
    "lit": "^3.3.1",
    "rimraf": "^6.0.1",
    "typescript": "~5.6.3",
    "vite": "^8.0.0-beta.13"
  }
}
